#!/bin/bash
set -euo pipefail
# postBuild script for Binder using pyproject.toml

# ensure pip is up to date and install Poetry
python -m pip install --upgrade pip
python -m pip install poetry

# install into the container environment (not a Poetry venv)
poetry config virtualenvs.create false --local

# If pyproject.toml is present, try Poetry; otherwise fall back to requirements.txt
if [ -f pyproject.toml ]; then
	echo "Found pyproject.toml — installing with Poetry"
	if ! poetry install --no-root --no-interaction --no-ansi; then
		echo "Poetry install failed — falling back to requirements.txt"
		pip install --upgrade pip
		if [ -f requirements.txt ]; then
			pip install -r requirements.txt
		else
			echo "No requirements.txt present — cannot install dependencies"
			exit 1
		fi
	fi
else
	echo "pyproject.toml not found — using requirements.txt"
	pip install --upgrade pip
	if [ -f requirements.txt ]; then
		pip install -r requirements.txt
	else
		echo "No requirements.txt present — nothing to install"
	fi
fi
